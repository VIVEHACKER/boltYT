{
  "name": "template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "remotion:preview": "remotion preview src/remotion/index.ts",
    "render": "npx ts-node --esm src/remotion/render-video.ts",
    "evaluate:render": "npx tsx server/lib/render-output-qc-cli.ts",
    "compare:render": "npx tsx server/lib/render-output-qc-cli.ts",
    "proxy": "npx tsx server/video-proxy.ts",
    "youtube": "npx tsx server/youtube-upload.ts",
    "render-queue": "npx tsx server/render-queue.ts",
    "api-proxy": "npx tsx server/api-proxy.ts",
    "reference-analyzer": "npx tsx server/reference-analyzer.ts",
    "reference:batch": "npx tsx scripts/reference-batch-template.ts",
    "reference:continue": "npx tsx scripts/reference-batch-template.ts --increment-per-category 2 --max-channels 25 --results-per-query 25 --candidate-pool 25",
    "reference:format100": "npx tsx scripts/reference-batch-template.ts --formats shorts,longform --target-per-category-format 10 --max-channels 40 --results-per-query 50 --candidate-pool 60 --fallback-ytsearch",
    "reference:format100:metadata": "npx tsx scripts/reference-batch-template.ts --formats shorts,longform --target-per-category-format 10 --max-channels 40 --results-per-query 50 --candidate-pool 60 --metadata-only --fallback-ytsearch",
    "reference:deep": "npx tsx scripts/reference-deep-promote.ts --target-per-category 1 --limit 5",
    "reference:deep:retry": "npx tsx scripts/reference-deep-promote.ts --target-per-category 9 --limit 45 --retry-deep --timeout-ms 900000",
    "reference:write": "npx tsx scripts/reference-batch-template.ts --offline",
    "bgm:import": "node scripts/import-bgm-preset.mjs",
    "set-fal-key": "node scripts/set-fal-key.mjs",
    "vlog:plan": "npx tsx scripts/historical-vlog-plan.ts",
    "vlog:make": "npx tsx scripts/make-vlog.ts",
    "vlog:batch": "npx tsx scripts/vlog-batch.ts",
    "vlog:economy": "npx tsx scripts/make-economy.ts",
    "quality:loop": "npx tsx scripts/post-generation-improvement-loop.ts",
    "quality:loop:fix": "npx tsx scripts/post-generation-improvement-loop.ts --fix",
    "quality:dead-exports": "node scripts/check-dead-exports.mjs",
    "quality:content-flow-ui": "npx tsx scripts/verify-content-production-flow.ts",
    "servers": "npx tsx server/api-proxy.ts & npx tsx server/youtube-upload.ts & npx tsx server/render-queue.ts & npx tsx server/reference-analyzer.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@porsche-design-system/components-react": "^3.33.0",
    "@remotion/bundler": "^4.0.448",
    "@remotion/cli": "^4.0.448",
    "@remotion/player": "^4.0.448",
    "@remotion/renderer": "^4.0.448",
    "@sentry/node": "^10.50.0",
    "@sentry/react": "^10.50.0",
    "@sentry/vite-plugin": "^5.2.0",
    "@supabase/supabase-js": "^2.103.0",
    "@tailwindcss/vite": "^4.2.2",
    "googleapis": "^171.4.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "remotion": "^4.0.448",
    "tailwindcss": "^4.2.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "playwright": "^1.59.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
