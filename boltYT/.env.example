# boltYT 환경변수 — .env로 복사하여 사용하세요
# cp .env.example .env

# ─── API 프록시 서버 (server/api-proxy.ts) ───

# OpenAI — GPT-4o-mini, DALL-E 3, TTS (필수)
OPENAI_API_KEY=

# LLM 실행 경로: openai 또는 claude. claude는 로컬 Claude CLI 로그인 필요
LLM_BACKEND=openai
CLAUDE_MODEL=sonnet
# LLM_REQUEST_TIMEOUT_MS=195000

# ElevenLabs — 고품질 TTS (선택)
ELEVENLABS_API_KEY=

# Pexels — 무료 이미지/영상 검색 (pexels.com/api 에서 발급)
PEXELS_API_KEY=

# Pixabay — 무료 영상/음악 검색 (pixabay.com/api/docs 에서 발급)
PIXABAY_API_KEY=

# YouTube Data API — 영상 검색 (console.cloud.google.com)
YOUTUBE_API_KEY=

# fal.ai 이미지/영상 생성(선택)
FAL_KEY=

# 네이버 검색 — 뉴스/이미지 검색 (developers.naver.com)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─── YouTube 업로드 서버 (server/youtube-upload.ts) ───

# Google OAuth 2.0 (console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── 포트 설정 (선택 — 기본값 사용 권장) ───

# API_PROXY_PORT=3459
# PROXY_PORT=3456
# YT_PORT=3457
# RENDER_PORT=3458

# ─── 경제 영상 생성기 ───

# 로컬 서비스 주소
# API_PROXY_URL=http://127.0.0.1:3459
# COMFY_URL=http://127.0.0.1:8188
# COMFY_ROOT=/Users/you/ComfyUI
# COMFY_PYTHON=/Users/you/ComfyUI/venv/bin/python

# 기본 고속 SDXL 프리셋. 설치된 체크포인트 이름으로 변경하세요.
COMFY_CKPT=DreamShaperXL_Turbo_V2-SFW.safetensors
COMFY_PRESET=fast
# COMFY_MODEL=sdxl

# elevenlabs | clova | edge | melo
TTS_PROVIDER=edge
TTS_SPEED=1.1
# 롱폼은 요청 길이의 90% 미만이면 완료 처리하지 않습니다.
# LONGFORM_MIN_DURATION_RATIO=0.9
# TTS_VOICE=
# EDGE_TTS_BIN=/Users/you/.local/bin/edge-tts
# EDGE_VOICE=ko-KR-SunHiNeural
# MELO_TTS=/absolute/path/to/tts-melo.sh
# MELO_URL=http://127.0.0.1:3461

# ─── 렌더 큐 인증 ───

# 렌더 큐 API 키 — POST /render 보호용 (빈 값이면 인증 비활성화)
RENDER_API_KEY=

# ─── Sentry 오류 모니터링 ───

# 브라우저 Sentry DSN (sentry.io 프로젝트 설정에서 발급)
VITE_SENTRY_DSN=

# 서버 Sentry DSN (브라우저와 동일하거나 별도 프로젝트 사용)
SENTRY_DSN=

# CI 소스맵 업로드 — 빌드 시에만 필요 (없으면 업로드 비활성화)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
